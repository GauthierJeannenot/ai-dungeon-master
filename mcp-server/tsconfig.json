{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["../mcp-server/**/*", "../lib/types.ts", "../lib/adventure-map.ts", "../lib/player-template.ts", "../lib/character-registry.ts", "../lib/srd/weapons.ts", "../lib/srd/spells.ts", "../lib/srd/skills.ts", "../adventures/**/map.ts", "../characters/**/sheet.ts"],
  "exclude": ["../node_modules", "../app", "../components", "./dist", "../mcp-server/dist"]
}
