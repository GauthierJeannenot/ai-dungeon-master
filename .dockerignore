# Dependencies (reinstalled inside the image)
node_modules

# Build artifacts (regenerated during the image build)
.next
mcp-server/dist

# Local runtime state (sessions/logs live on a mounted volume, not the image)
.data
data
caddy_data
caddy_config

# VCS / tooling
.git
.github
.claude
.vscode

# Local env files. Secrets are injected by the deployment target.
.env*
!.env.example

# Misc
npm-debug.log*
*.log
README*.md
