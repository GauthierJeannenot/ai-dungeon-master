{
  "name": "ai-dungeon-master",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:mcp && concurrently \"next dev\" \"node mcp-server/dist/mcp-server/index.js\"",
    "dev:mock": "node scripts/dev-mock.cjs",
    "playtest": "node scripts/playtest.cjs",
    "replay:session-log": "node scripts/replay-session-log.cjs",
    "eval:intent": "node scripts/evaluate-intent-interpreter.cjs --strict",
    "playtest:mock": "npm run build:mcp && node scripts/playtest.cjs --mode mock --narration-mode quality",
    "playtest:budget": "npm run build:mcp && node scripts/playtest.cjs --mode mock --narration-mode budget",
    "build:mcp": "tsc -p mcp-server/tsconfig.json",
    "build": "npm run build:mcp && next build",
    "typecheck": "npm run typecheck:mcp && npm run typecheck:next",
    "typecheck:mcp": "tsc -p mcp-server/tsconfig.json --noEmit",
    "typecheck:next": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "npm run build:mcp && node --test tests/*.test.cjs",
    "db:migrate": "node scripts/db-migrate.cjs",
    "db:import": "node scripts/db-import-file-stores.cjs",
    "start": "next start"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@auth/pg-adapter": "^1.11.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "concurrently": "^9.2.1",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "8.5.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
