# Required for live Anthropic calls.
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DONNÉES — Postgres (REQUISE)
# Postgres est le SEUL backend de persistance : auth NextAuth (users/accounts/
# sessions), sessions de jeu et crédits/quotas. Sans DATABASE_URL, aucune de ces
# opérations n'aboutit (fatal en prod, erreur claire en dev).
# Dev : `docker compose up -d` (docker-compose.yml fourni), puis l'URL ci-dessous.
# Schéma : appliqué automatiquement au premier accès, ou via `npm run db:migrate`.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_dm
# TLS vers un Postgres managé externe exposé publiquement :
# DATABASE_SSL=require
# Taille du pool de connexions (défaut : 10)
# DATABASE_POOL_MAX=10

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTIFICATION — NextAuth (OAuth 2.0)
# Sessions "database" persistées en Postgres (users.id = identifiant du solde).
# ─────────────────────────────────────────────────────────────────────────────
# Générer avec : npx auth secret
AUTH_SECRET=change-me-long-random
# Google OAuth (https://console.cloud.google.com → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub OAuth (https://github.com/settings/developers → OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# URL publique de l'app en prod (utile derrière un proxy)
# AUTH_URL=https://votre-app.example.com

# ─────────────────────────────────────────────────────────────────────────────
# PAIEMENTS — Stripe
# exemple TO DO remplir les informations bancaires pour le paiement :
#   1. dashboard.stripe.com → activer le compte + renseigner le compte bancaire
#      de payout (Settings → Bank accounts and currencies)
#   2. copier la clé secrète ci-dessous (sk_test_... puis sk_live_...)
#   3. créer le webhook (Developers → Webhooks → endpoint
#      https://<domaine>/api/stripe/webhook, événement checkout.session.completed)
#      et copier son signing secret ci-dessous
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# MONÉTISATION — tokens & quota invité
# ─────────────────────────────────────────────────────────────────────────────
# Messages gratuits pour un visiteur non connecté (défaut : 5)
# GUEST_MESSAGE_LIMIT=5
# Tokens offerts au premier login (défaut : 10 ; 0 pour désactiver)
# SIGNUP_BONUS_TOKENS=10
# URL publique de l'app — redirections Stripe (sinon header origin du client)
# APP_BASE_URL=https://votre-app.example.com

# ─────────────────────────────────────────────────────────────────────────────
# ANTI-ABUS — /api/dm coûte de l'argent à chaque message
# ─────────────────────────────────────────────────────────────────────────────
# Messages par minute et par IP (défaut : 8 ; 0 = désactivé)
# DM_RATE_LIMIT_PER_MINUTE=8
# Plafond GLOBAL de messages par jour UTC — disjoncteur de dépense Anthropic
# (défaut : 2000 ; 0 = désactivé). En Postgres le compteur est partagé entre instances.
# DM_DAILY_GLOBAL_MESSAGE_LIMIT=2000
# Tours de conversation conservés dans la session persistée (défaut : 200)
# DM_MAX_STORED_HISTORY_TURNS=200
# Longueur max d'un message joueur en caractères (défaut : 2000). Au-delà → 400
# avant tout débit : borne le coût LLM d'un message géant.
# DM_MAX_MESSAGE_CHARS=2000

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION — définir comme variables d'environnement de l'hébergeur
# (Railway Variables, .env.local sur une VM, etc.).
# ─────────────────────────────────────────────────────────────────────────────
# Active les vrais appels LLM (par défaut déjà "live" si non défini).
# LLM_MODE=live
# ALLOW_PAID_LLM=true
#
# SÉCURITÉ : /api/debug/logs est fermé en production (Bearer token obligatoire,
# 404 si aucun token configuré). La lecture publique n'existe qu'en dev local.
# Pour un accès protégé en prod :
# APP_DEBUG_LOG_TOKEN=change-me-long-random
# En dev local, pour désactiver aussi la lecture publique :
# APP_DEBUG_LOG_PUBLIC_READ=false
#
# La persistance fichier des logs est coupée par défaut en production (stdout
# suffit, capturé par l'hébergeur). Opt-in explicite :
# APP_LOG_PERSIST_ENABLED=true

# Modèles & effort (les valeurs par défaut conviennent ; surcharge optionnelle).
# DM_MODEL=claude-sonnet-4-6           # narration (le plus coûteux)
# DM_PLANNER_MODEL=claude-haiku-4-5    # classifieur d'intention
# DM_COMPRESS_MODEL=claude-haiku-4-5   # compression d'historique (défaut = planner)
# DM_EFFORT=medium                     # low | medium | high | xhigh | max (Sonnet 4.6/Opus 4.5+)

# Local no-cost development mode. Copy these to .env.local when you want
# deterministic gameplay tests without paid LLM calls.
# NB: LLM_MODE ne connaît QUE mock | live (les modes record/replay à cassettes
# ont été supprimés).
LLM_MODE=mock
ALLOW_PAID_LLM=false

# Optional LLM budget guards for manual live playtests.
LLM_MAX_CALLS_PER_REQUEST=10
LLM_PROMPT_CACHE_ENABLED=true
# TTL du cache Anthropic sur le bloc système statique : '1h' (défaut) ou '5m'.
# En jeu de rôle le joueur laisse souvent passer >5 min entre deux messages ;
# le cache 1h reste chaud (relecture à 0,1×) là où un cache 5m aurait expiré.
# Écriture 1h = 2× l'input vs 1,25× en 5m, amortie dès ~3 relectures.
LLM_PROMPT_CACHE_TTL=1h

# Optional automated playtest objectives.
PLAYTEST_MAX_COST_USD=0.05
PLAYTEST_MIN_LLM_NARRATOR_RATIO=0.75
PLAYTEST_MAX_AVERAGE_LLM_CALLS=1.2
PLAYTEST_MAX_SIMPLE_TURN_LLM_CALLS=2

# Optional debug logging knobs for local investigations.
# APP_LOG_LEVEL=debug
# APP_LOG_INCLUDE_TEXT=true
# APP_DEBUG_LOG_PUBLIC_READ=true
