# AI Dungeon Master — configuration locale et production
# Copier ce fichier vers .env.local à la racine ; ne jamais committer les secrets.
# Local : générer AUTH_SECRET ci-dessous, docker compose up -d, npm run dev:mock.
# Le schéma Postgres est appliqué au premier accès. Le script npm run db:migrate
# attend DATABASE_URL dans l'environnement du shell ; il ne charge pas .env.local.
# Production : définir les variables chez l'hébergeur et appliquer le bloc
# « Production » ci-dessous. Déployer UNE instance Node persistante (moteurs MCP
# enfants par session ; pas de fonctions serverless ni de scaling horizontal).
# Construire avec npm run build, démarrer avec npm start.
# Ne pas définir NODE_ENV ici : Next.js le fixe selon dev / build / start.

# ── Local : base requise et jeu en mock, sans appels LLM payants ────────────────
# Postgres reste requis en mock et avec MONETIZATION_ENABLED=false.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_dm
LLM_PROVIDER=openai
# Seuls modes supportés : mock | live. Sans variable, le code utilise live.
LLM_MODE=mock
ALLOW_PAID_LLM=false
# Pour jouer en live localement : LLM_MODE=live, ALLOW_PAID_LLM=true, clé du
# fournisseur ci-dessous, puis npm run dev (dev:mock force toujours le mock).
# false : contourne auth/crédits/quota invité des routes de jeu en développement.
# Les limites par IP et le plafond global journalier restent actifs.
# L'interface de connexion et les routes OAuth restent présentes.
MONETIZATION_ENABLED=false

# ── Authentification : secret local, puis Google si les comptes sont utilisés ──
# Remplir AUTH_SECRET même en local : la page d'accueil appelle Auth.js.
# Générer un secret distinct par environnement, par exemple avec :
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Nécessaires pour se connecter via Google ; inutiles pour jouer en mock invité.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Déclarer cette URI de redirection dans le client OAuth Google :
# http://localhost:3000/api/auth/callback/google
# Pour tester aussi les quotas/crédits, passer MONETIZATION_ENABLED=true.

# ── Production : définir ces valeurs dans l'environnement de l'hébergeur ──────
# Requis pour un serveur de jeu en production avec appels OpenAI et comptes/crédits.
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
# MONETIZATION_ENABLED=true
# LLM_PROVIDER=openai
# LLM_MODE=live
# ALLOW_PAID_LLM=true
# OPENAI_API_KEY=<cle-api-openai>
# AUTH_SECRET=<secret-aleatoire-genere-pour-la-production>
# OAuth Google, nécessaire pour les comptes et l'achat de crédits :
# AUTH_GOOGLE_ID=<client-id-oauth-production>
# AUTH_GOOGLE_SECRET=<client-secret-oauth-production>
# AUTH_URL=https://votre-app.example.com
# AUTH_URL est facultatif si Auth.js détecte correctement l'URL publique ; le
# définir explicitement derrière un proxy ou si l'URL ne peut pas être détectée.
# APP_BASE_URL ne sert que si Stripe est activé :
# APP_BASE_URL=https://votre-app.example.com
# Déclarer aussi https://votre-app.example.com/api/auth/callback/google dans Google.
# Pour activer les paiements, renseigner les deux clés Stripe et APP_BASE_URL :
# STRIPE_SECRET_KEY=sk_live_<cle-secrete>
# STRIPE_WEBHOOK_SECRET=whsec_<secret-webhook>
# Configurer le webhook Stripe checkout.session.completed vers
# https://<domaine>/api/stripe/webhook.
# Ne pas définir NODE_ENV : Next.js le fixe à production au démarrage.

# ── Postgres : options local / production ──────────────────────────────────────
# Pool par processus (défaut : 10).
# DATABASE_POOL_MAX=10
# Seulement si le Postgres externe exige TLS ; laisser absent pour le réseau
# interne Railway ou le Docker local. « require » désactive la vérification du
# certificat dans lib/db.ts ; respecter la configuration TLS de l'hébergeur.
# DATABASE_SSL=require

# ── API OpenAI : MJ et résumés ────────────────────────────────────────────────
# Guide : docs/openai.md. En live : LLM_MODE=live et ALLOW_PAID_LLM=true.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=60000
# DM_MODEL=gpt-5.4-mini
# DM_COMPRESS_MODEL=gpt-5.4-mini
# Le modèle par défaut utilise une fenêtre de 400000 tokens, sans raisonnement.
# Pour tout autre modèle, configurer sa fenêtre documentée.
# OPENAI_CONTEXT_WINDOW_TOKENS=400000
# OPENAI_COMPRESS_CONTEXT_WINDOW_TOKENS=400000
# Facultatif, selon le modèle ; augmenter les budgets de sortie si activé.
# OPENAI_REASONING_EFFORT=none
# LLM_COMPRESS_MAX_TOKENS=300
# LLM_CONTEXT_RESERVE_TOKENS=4096
# Tarifs USD par million de tokens ; estimations nulles si non configurés.
# OPENAI_INPUT_USD_PER_MTOK=0.75
# OPENAI_CACHED_INPUT_USD_PER_MTOK=0.075
# OPENAI_OUTPUT_USD_PER_MTOK=4.50

# ── Paiements Stripe : optionnels, avec comptes Google configurés ──────────────
# Laisser vide pour désactiver les achats. En local : clé sk_test_... ; en prod :
# sk_live_... et secret du webhook de production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook : https://<domaine>/api/stripe/webhook
# Événement requis : checkout.session.completed (crédite les tokens/accès).
# Pour les paiements locaux :
# stripe listen --forward-to localhost:3000/api/stripe/webhook
# Copier le whsec_... renvoyé dans STRIPE_WEBHOOK_SECRET.
# APP_BASE_URL=http://localhost:3000

# ── Quotas et limites : valeurs par défaut, surcharges optionnelles ─────────────
# Messages invités gratuits ; bonus en tokens au premier login (0 autorisé).
# GUEST_MESSAGE_LIMIT=5
# SIGNUP_BONUS_TOKENS=10
# Messages par IP/minute et plafond global/jour UTC (0 = désactivé).
# DM_RATE_LIMIT_PER_MINUTE=8
# DM_DAILY_GLOBAL_MESSAGE_LIMIT=2000
# Messages d'historique conservés en base et taille max d'un message (caractères).
# DM_MAX_STORED_HISTORY_TURNS=200
# DM_MAX_MESSAGE_CHARS=2000
# Itérations consécutives sans nouvelle résolution MCP réussie avant arrêt.
# Les résolutions réussies ne sont pas plafonnées par ce réglage.
# LLM_MAX_STALLED_ITERATIONS=6
# Budget de sortie par appel MJ (tokens).
# LLM_MAX_TOKENS=1024
# Historique récent conservé verbatim (messages ; réductible sous pression de contexte).
# LLM_HISTORY_KEEP_RECENT=10
# Compression des anciens messages dès ce seuil (caractères).
# LLM_HISTORY_COMPRESS_THRESHOLD_CHARS=4000
# Entrées du journal de combat injectées dans le contexte.
# LLM_COMBAT_LOG_TAIL=6

# ── Diagnostic : options local / production ────────────────────────────────────
# Niveau par défaut : debug en local, info en production.
# Valeurs : debug | info | warn | error.
# APP_LOG_LEVEL=debug
# Le texte est inclus par défaut ; le désactiver en production pour ne pas
# journaliser le texte des joueurs.
# APP_LOG_INCLUDE_TEXT=false
# Taille max des chaînes, tableaux et objets consignés dans un événement.
# APP_LOG_STRING_LIMIT=800
# APP_LOG_ARRAY_LIMIT=30
# APP_LOG_OBJECT_KEY_LIMIT=80
# Buffer mémoire des événements, actif par défaut.
# APP_LOG_BUFFER_ENABLED=true
# APP_LOG_BUFFER_LIMIT=1000
# /api/debug/logs : lecture publique en local par défaut ; false la désactive.
# APP_DEBUG_LOG_PUBLIC_READ=false
# En production : Bearer obligatoire, 404 sans token. La lecture publique y est
# toujours désactivée. Utiliser un secret dédié d'au moins 16 caractères.
# APP_DEBUG_LOG_TOKEN=<secret-aleatoire-debug>
# Garder l'accès par query string désactivé ; utiliser le Bearer ou l'en-tête.
# APP_DEBUG_LOG_TOKEN_QUERY_ENABLED=false
# Logs JSONL sur disque : activés par défaut en local, désactivés en production.
# APP_LOG_PERSIST_ENABLED=false
# Réglages des fichiers si la persistance disque est activée.
# APP_LOG_PERSIST_MAX_BYTES=20000000
# APP_LOG_PERSIST_DIR=./.data/logs
# APP_LOG_PERSIST_FILE=server.jsonl
# HUD de télémétrie dans l'écran de jeu, masqué par défaut. NEXT_PUBLIC_* est
# figé au build : définir avant npm run build pour une version de production.
# NEXT_PUBLIC_DEBUG_HUD=true

# ── Collecte d'entraînement : indépendante des logs de diagnostic ──────────────
# Traces complètes persistées en Postgres ; fichiers JSONL en plus par défaut
# en local, désactivés par défaut en production. APP_LOG_INCLUDE_TEXT ne pilote
# pas cette collecte. LLM_TRAINING_FILE_ENABLED ne pilote que les fichiers.
# LLM_TRAINING_FILE_ENABLED=false
# LLM_TRAINING_DIR=./llm_training
# Export GET /api/llm_training : Bearer obligatoire avec LLM_TRAINING_TOKEN,
# sinon APP_DEBUG_LOG_TOKEN ; minimum 16 caractères, sinon endpoint fermé.
# LLM_TRAINING_TOKEN=<secret-export-entrainement>
# Garder les fichiers désactivés en production sauf besoin explicite : les traces
# complètes sont déjà conservées dans Postgres.
# Révision de secours si l'hébergeur ne fournit pas son commit Railway/Vercel.
# APP_REVISION=<commit-ou-version>
