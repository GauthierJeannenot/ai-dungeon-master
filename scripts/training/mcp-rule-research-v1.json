{
  "schemaVersion": 1,
  "description": "Démonstrations écrites de l’agent MCP : consultations choisies par l’agent avant une action, lectures paginées, reformulation et contrastes directs. Aucun joueur ne demande de consulter les règles.",
  "scenarios": [
    {
      "id": "agent-research-perception-success",
      "group": "wisdom-perception",
      "split": "train",
      "adventureId": "grammys-country-apple-pie",
      "characterId": "fighter",
      "ruleLookupInitiative": "agent",
      "diceSequence": "17",
      "message": "Je tends l’oreille pour repérer les sons autour de moi, sans me déplacer.",
      "unchanged": [
        "player.position",
        "player.hp",
        "player.inventory",
        "worldFacts"
      ],
      "steps": [
        {
          "operation": "dm.turn",
          "checks": [],
          "tool": {
            "name": "consult_rules",
            "input": {
              "book": "srd-5.1-2014",
              "query": "Wisdom checks"
            }
          }
        },
        {
          "operation": "dm.turn",
          "checks": [
            {
              "path": "lastToolResult.kind",
              "equals": "search"
            },
            {
              "path": "lastToolResult.results.0.source.license",
              "equals": "CC-BY-4.0"
            }
          ],
          "tool": {
            "name": "consult_rules",
            "input": {
              "sectionId": {
                "$ref": "lastToolResult.results.0.sectionId"
              },
              "limit": 5000
            }
          }
        },
        {
          "operation": "dm.turn",
          "checks": [
            {
              "path": "lastTool.name",
              "equals": "consult_rules"
            },
            {
              "path": "lastToolResult.kind",
              "equals": "passage"
            },
            {
              "path": "lastToolResult.source.license",
              "equals": "CC-BY-4.0"
            },
            {
              "path": "lastToolResult.text",
              "includes": "Perception."
            }
          ],
          "tool": {
            "name": "roll_ability_check",
            "input": {
              "entityId": "player",
              "ability": "wis",
              "skill": "perception",
              "dc": 15,
              "label": "Écoute",
              "sightBased": false
            }
          }
        },
        {
          "operation": "dm.turn",
          "checks": [
            {
              "path": "lastTool.name",
              "equals": "roll_ability_check"
            },
            {
              "path": "lastTool.isError",
              "equals": false
            },
            {
              "path": "lastToolResult.success",
              "equals": true
            }
          ],
          "text": "Ton test de Écoute est réussi. Tu restes sur place ; ce jet ne crée pas automatiquement une découverte."
        }
      ]
    },
